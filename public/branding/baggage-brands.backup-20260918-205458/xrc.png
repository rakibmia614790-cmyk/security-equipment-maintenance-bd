                        </div>
                        <div class="models-text">
                          <p>More than 30 models with different sizes and features.</p>
                        </div>
                      </div>
                    </div>
                    <div class="clients wow anim--slideUp">
                      <div class="flex-wrapper fw-column">
                        <div class="clients-count">
                          <span id="ContentPlaceHolder1_divrakam3" class="counter clients-counter" data-count="1500">1500</span>
