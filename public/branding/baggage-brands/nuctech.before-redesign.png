    <script type="text/javascript">
        function mover(obj) {
            var cl = $(obj).offset().left;
            var nl = $(".nuctechnav").offset().left;
            var ml = cl - nl >= 10 ? cl - nl : 10;
            $(".slidernav").animate({"left": ml - 44 + "px", "right": "0px"}, 200);
        }

        function initsliderpotion() {
            if ($(".selectedItem") != null && $(".selectedItem").offset() != null) {
                var cl = $(".selectedItem").offset().left;
                var nl = $(".nuctechnav").offset().left;
                var ml = cl - nl >= 10 ? cl - nl : 10;
                $(".slidernav").animate({"left": ml - 44 + "px", "right": "0px"}, 200);
            } else {
                if ($(".slidernav") != null) {
                    $(".slidernav").animate({"left": "0px", "right": "0px"}, 200);
                }
            }

            $("#pc").height($(window).height());
        }
    </script>

    <script type="text/javascript">


        // ==============菜单===========//
        ddsmoothmenu.init({
            mainmenuid: "ctl00_ucTopMenu_smoothmenu1",
            orientation: 'h',
            classname: 'ddsmoothmenu',
            contentsource: "markup"
        });

        (function () {

            $(document).ready(function () {
                $('img').on('error', function () {
                    //console.log('error', "图片获取失败")
                    if ($(this).closest('.itemprocontent, .itemcontent, .colitemcontent, .rowitemcontent, .legalstatment').length > 0) {
                        return;
                    }
                    $(this).attr('src', '../images/about.jpg');
                });
            })

            var time = null;
            var list = $(".nuctechnavi");
            var box = $("#navbox");
            var lista = list.find("li.menuli");

            var box_show = function (hei) {
                box.stop().animate({
                    height: hei,
                    opacity: 1
                }, 400);
            }

            var box_hide = function () {
                box.stop().animate({
                    height: 0,
                    opacity: 0
                }, 400);
            }

            // 修复jQuery升级后菜单显示问题，同时保留动画效果
            var isMouseOverMenu = false;
            var isMouseOverBox = false;

            lista.hover(
                function () { // mouseenter
                    isMouseOverMenu = true;
                    clearTimeout(time); // 立即清除任何待执行的隐藏操作
                    lista.removeClass("selectedli");
                    $(this).addClass("selectedli");
                    mover(this);
                    var index = list.find("li").index($(this));
                    var $curbox = box.find(".cont").hide().eq(index);
                    if ($curbox.hasClass("conthri")) {
                        box.removeClass("vhovermenu");
                        box.addClass("hhovermenu");
                    } else {
                        box.removeClass("hhovermenu");
                        box.addClass("vhovermenu");
                    }
                    $curbox.show();
                    var _height = $curbox.outerHeight(true);
                    box_show(_height);
                },
                function () { // mouseleave
                    isMouseOverMenu = false;
                    var self = this;
                    setTimeout(function() {
                        if (!isMouseOverBox && !isMouseOverMenu) { // 只有当鼠标不在box上且不在任何菜单项上时才隐藏
                            time = setTimeout(function () {
                                box.find(".cont").hide();
                                box_hide();
                                mout(self);
                            }, 500);
                            lista.removeClass("selectedli");
                        }
                    }, 50); // 小延迟以允许鼠标移动到box上
                }
            );

            box.hover(
                function () { // mouseenter
                    isMouseOverBox = true;
                    clearTimeout(time);
                    // 保持菜单显示，取消任何待执行的隐藏操作
                },
                function () { // mouseleave
                    isMouseOverBox = false;
                    var self = this;
                    setTimeout(function() {
                        if (!isMouseOverMenu) { // 只有当鼠标不在menu上时才隐藏
                            time = setTimeout(function () {
                                box.find(".cont").hide();
                                box_hide();
                                mout(self);
                            }, 500);
                            lista.removeClass("selectedli");
                        }
                    }, 50); // 小延迟以允许鼠标移动到其他menu项
                }
            );
        })();

        // ==============菜单 end===========//
        function mout(obj) {
            initsliderpotion();
        }


        $("#globalSearchButton").click(function () {
            const keyword = $("#globalSearchInput").val()
            window.location.href = "/search?type=global&page=1&keyword=" + keyword;
        })

        $("#globalSearchInput").on('keyup', function (event) {
            if (event.keyCode === 13) {
                const keyword = $("#globalSearchInput").val()
                window.location.href = "/search?type=global&page=1&keyword=" + keyword;
            }
        });


    </script>

