    <script type="text/javascript">

        function PhoneSearchClick() {
            const keyword = $("#Phone_InputSearch").val()
            window.location.href = "/search?type=global&page=1&keyword=" + keyword;
        }

        $(document).ready(function () {


            $('img').on('error', function () {
                //console.log('error', "图片获取失败")
                if ($(this).closest('.itemprocontent, .itemcontent, .colitemcontent, .rowitemcontent, .legalstatment').length > 0) {
                    return;
                }
                $(this).attr('src', '../images/about.jpg');
            });

            // mobile

            $(".Phone_search").click(function () {
                $(".Phone_divsearch").toggleClass('d-block');
            })
            $(".Phone_nav").click(function () {
                $(".Phone_divnav").toggleClass('d-block');
            })

            $(".phone_menuli").click(function () {
                $(this).toggleClass('open');
                $(this).find('.div_menuscroll').toggleClass('d-block');
                $(this).find('.div_menuscroll .cont').css('display', 'block');
            })
            $("#PhoneNavClose img").click(function () {
                $(".Phone_divnav").removeClass('d-block');
            })

            $(".productmore").click(function () {
                $('.Product-wrapper').toggleClass('d-block');
                $('#PhoneProductMoreNav').toggleClass('d-block');
            })
        })


        function showWechat() {
            $("#divweixinphoto").css("display", "block");
        }

        function toTop() {
            $('body,html').animate({scrollTop: 0}, 800);
        }

        $(window).scroll(function (e) {
            if ($(this).scrollTop() >= 50) {
                $('.divHuiTop').css("display", "block");
            } else {
                $('.divHuiTop').css("display", "none");
            }
        });


        function hideimg() {
            $("#divweixinphoto").css("display", "none");
        }

    </script>

    <script type="text/javascript">

        $(document).ready(function () {
            $(".banner").slide({
                titCell: ".hd ul",
                mainCell: ".bd ul",
                effect: "fold",
                autoPlay: true,
                autoPage: true,
                trigger: "click"
            });
            $(".newscroll").slide({mainCell: ".newsul", autoPage: true, effect: "top", autoPlay: true, vis: 1});

            $('.product-select-item').click(function () {
                const id = $(this).data("id")
                $('.product-select-item.' + id).addClass('select-active')
                $('.product-select-item').not('.' + id).removeClass('select-active');
                $('.phoneproductul').each(function (index, item) {
                    const it = $(item)
                    console.log(it)
                    if (it.data("id") === id) {
                        it.addClass('each-active').removeClass('each-hide')
                    } else {
                        it.addClass('each-hide').removeClass('each-active')
                    }
                })
            })

        })

        function SeeMoreProduct() {
            $('.PProductMore').addClass('d-none').removeClass('d-block');
            $('.PProductHide').addClass('d-block').removeClass('d-none');
            $('.product-more').addClass('d-block').removeClass('d-none');
            console.log('动态加载产品列表');
        }

        function HideProduct() {
            $('.PProductMore').addClass('d-block').removeClass('d-none');
            $('.PProductHide').addClass('d-none').removeClass('d-block');
            $('.product-more').addClass('d-none').removeClass('d-block');
            console.log('动态加载产品列表');
        }

    </script>

    <style type="text/css">

        .select-active {
            color: #005496;
        }

        .each-active {
            display: block;
        }

        .each-hide {
            display: none;
        }
