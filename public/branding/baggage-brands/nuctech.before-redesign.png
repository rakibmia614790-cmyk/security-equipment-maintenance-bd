    <script>

        $(document).ready(function () {
            //添加切换方法
            ChangeTableStyle(0);
            var myinterval;
            var changeflag = 0;
            // var siteUrl1 = _spPageContextInfo.webServerRelativeUrl;


            const showVideo = true

            console.log(showVideo, 'showVideo')
            if (showVideo) {
                myinterval = setInterval(function () {
                    ChangeTableStyle(changeflag)
                }, 10000);
            }

            $("#newstitle").mouseover(function () {
                clearTimeout(myinterval);
                ChangeTableStyle(0);
            });


            if (showVideo) {

                $("#newsvideocenter").mouseout(function () {
                    myinterval = setInterval(function () {
                        ChangeTableStyle(changeflag)
                    }, 10000);
                });


                $("#videotitle").mouseover(function () {
                    clearTimeout(myinterval);
                    ChangeTableStyle(1);
                });

                $("#newsvideocenter").mouseover(function () {
                    clearTimeout(myinterval);
                })
            }


            $(".cnlefticon").find("img").hide().eq(0).show();

            $(".cnitem").mouseover(function () {
                $(this).find(".itemicon").addClass("itemiconhover");
                $(this).find(".itemicon").removeClass("itemicon");
                var index = $(".cnitembody").find(".cnitem").index($(this));
                $(".cnlefticon").find("img").hide().eq(index).show();
            }).mouseout(function () {
                $(this).find(".itemiconhover").addClass("itemicon");
                $(this).find(".itemiconhover").removeClass("itemiconhover");
                $(".cnlefticon").find("img").hide().eq(0).show();
            });


            function ChangeTableStyle(isshow) {
                var ttype = isshow;
                if (ttype == 0) {
                    $("#newscontent").fadeIn();
                    $("#videocontent").fadeOut();
                    $("#newstitle").attr("class", "cnheadertitle_show");
                    $("#videotitle").attr("class", "cnheadertitle");
                    //修改more的链接到新闻
                    $("#videoandnewsmore").attr("href", "/news-center");

                } else {
                    $("#newscontent").fadeOut();
                    $("#videocontent").fadeIn();
                    $("#newstitle").attr("class", "cnheadertitle");
                    $("#videotitle").attr("class", "cnheadertitle_show");
                    //修改more的链接到视频中心
                    $("#videoandnewsmore").attr("href", "/video-center");
                }
                if (changeflag == 0) changeflag = 1; else changeflag = 0;
            }
        });
    </script>
</div>

                </div>
                <div class="containerline"></div>
            </div>
        </div>

    </section>
