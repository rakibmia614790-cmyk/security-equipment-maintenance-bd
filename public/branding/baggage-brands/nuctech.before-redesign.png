        const filePath = ".\/files\/";


        $("#productSearchInput").on('keyup', function (event) {
            if (event.keyCode === 13) {
                const keyword = $("#productSearchInput").val()
                window.location.href = "/search?type=global&page=1&keyword=" + keyword;
            }
        });

        $("#productSearchButton").click(function () {
            const keyword = $("#productSearchInput").val()
            window.location.href = "/search?type=global&page=1&keyword=" + keyword;
        })


        $(".productdisplay").slide({
            mainCell: ".productshow ul",
            effect: "leftLoop",
            vis: 5,
            scroll: 1
        });

        const onclickProduct = function (id, that) {
            if (!id || !that) return;
            $(".productseleteditem").removeClass("productseleteditem");
            that.addClass("productseleteditem");
            // 动态切换数据，先注释掉

            const menuItem = product_menu.find((it) => it.keyWords === id);
            if (!menuItem || !menuItem.children) return;
            const arr = menuItem.children;

            var str = [];
            $(".productshow").html("");
            str.push('<ul class="productlist">');

            arr.forEach((item) => {
                let s = `
                       <li>
                            <div class="productimg">
                                <a class="product-image" href="/productdetail?id=${item.id}" title="${item.title}">
                                    <img alt="" src="${filePath}${item.linkAddress}" width="228px" height="172px">
                                </a>
                                <div class="productdesc">
                                    <a href="/productdetail?id=${item.id}">${item.title}</a>
                                        <div class="productinnerdesc">${item.title}<div>
                                    </a>
                                </div>
                            </div>
                       </li>
                    `;
                str.push(s)
            })

            str.push('</ul>');
            $(".productshow").html(str.join(""));
            $(".productdisplay").unbind("slide");
            $(".productdisplay").slide({
                mainCell: ".productshow ul",
                effect: "leftLoop",
                vis: 5,
                scroll: 1
            });
        };

        // 默认显示全部产品，不选中任何分类
        (function() {
            var allProducts = [];
            product_menu.forEach(function(menuItem) {
                if (menuItem.children && menuItem.children.length > 0) {
                    allProducts = allProducts.concat(menuItem.children);
                }
            });

            var str = [];
            str.push('<ul class="productlist">');
            allProducts.forEach(function(item) {
                var s = `
                       <li>
                            <div class="productimg">
                                <a class="product-image" href="/productdetail?id=${item.id}" title="${item.title}">
                                    <img alt="" src="${filePath}${item.linkAddress}" width="228px" height="172px">
                                </a>
                                <div class="productdesc">
                                    <a href="/productdetail?id=${item.id}">${item.title}</a>
                                        <div class="productinnerdesc">${item.title}<div>
                                    </a>
                                </div>
                            </div>
                       </li>
                    `;
                str.push(s);
            });
            str.push('</ul>');
            $(".productshow").html(str.join(""));
            $(".productdisplay").slide({
                mainCell: ".productshow ul",
                effect: "leftLoop",
                vis: 5,
                scroll: 1
            });
        })();

        //产品分类标题点击事件
        $(".productitem").on("click", function () {

            const id = $(this).attr("id");
            onclickProduct(id, $(this))

        });

        /****************product slider***************/
        var index = 0;
        var _sn = 0;

        $(".tab_title ul li").click(function () {
            index = $(".tab_title ul li").index(this);
            $(this).addClass("selected").siblings().removeClass("selected");
        });
        var i = 3;
        var len = $(".u .scrol li").length;  //获得li元素的个数
        var page = 1;
        var maxpage = 3; //Math.ceil(len - 8); //元素的最大页数
        var scrollWidth = 0; // $(".u").width(); //设置元素的宽度
        $(".vright").on("click", function (e) {
            scrollWidth = pixelToInt($(".u .scrol li").eq(_sn), "width") + pixelToInt($(".u .scrol li").eq(_sn + 1), "width") + pixelToInt($(".u .scrol li").eq(_sn + 2), "width");

            if (!$(".u .scrol").is(":animated")) { //.u.scrol是否包含animated   :animated选取当前的动画元素
                if (page == maxpage) {
                    _sn = (maxpage - 1) * i;
                    $(".u .scrol").stop(); //停止当前正在运行的动画
                    $("#div1").css({
                        "top": (e.pageY + 20) + "px",
                        "left": (e.pageX + 20) + "px",
                        "opacity": "0.9"
                    }).stop(true, false).fadeIn(800).fadeOut(800); //显示与隐藏
                } else {
                    _sn += i;
                    $(".u .scrol").animate({left: "-=" + scrollWidth + "px"}, 500); //设置元素的宽度
                    page++;
                }
            }
        });
        $(".vleft").on("click", function () {
            scrollWidth = pixelToInt($(".u .scrol li").eq(_sn - 1), "width") + pixelToInt($(".u .scrol li").eq(_sn - 2), "width") + pixelToInt($(".u .scrol li").eq(_sn - 3), "width");

            if (!$(".u .scrol").is(":animated")) {
                if (page == 1) {
                    $(".u .scrol").stop();
                    _sn = 0;
                } else {
                    _sn -= 3;
                    $(".u .scrol").animate({left: "+=" + scrollWidth + "px"}, 500);
                    page--;
                }
            }
        });


    </script>
</div>
