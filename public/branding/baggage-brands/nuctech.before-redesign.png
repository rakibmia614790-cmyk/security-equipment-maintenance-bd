                <script type="text/javascript">

                    const filePath1 = ".\/files\/";

                    function changevideo(e) {

                        console.log(e.currentTarget)

                        $(".videoItem").find(".cntitle").css("text-decoration", "none");
                        if (e.target.getAttribute('class') === 'cntitle') {
                            $(this).css("text-decoration", "underline");
                        }

                        let url = e.currentTarget.getAttribute('data-url');
                        let poster = e.currentTarget.getAttribute('data-poster');

                        if (url) {
                            url = url.startsWith('http') ? url : filePath1 + url;
                        }

                        if (poster) {
                            poster = poster.startsWith('http') ? poster : filePath1 + poster;
                        }

                        // $(".videoItem").find(".cntitle:not(#text-"+$(this).id+")").css("text-decoration", "none");
                        // $(".videoItem").css("background-image", "none");
                        // $(".videoItem").css("background-position", "right top");
                        // $(".videoItem").css("background-repeat", "no-repeat");

                        console.log(url)

                        $("#player1").attr("src", encodeURI(url));
                        $("#player1").attr("poster", encodeURI(poster));
                    }

                    function jumpNewsDetail(e) {
                        let id = $('.cnlefticon').find('a').attr('id');
                        //console.log(id)
                        if (id)
                            window.location.href = '/news?id=' + id;
                    }
                </script>

