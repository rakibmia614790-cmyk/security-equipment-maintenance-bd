    <script>


        $(document).ready(function () {
            if (window.innerWidth < 768) {
                const content = window.localStorage.getItem("meta-device-width-content");
                if (content != null && content.length <= 0) {
                    toPC()
                } else {
                    toMobile()
                }
            }
        })

        function isMobile() {
            const content = window.localStorage.getItem("meta-device-width-content");
            return window.innerWidth < 768 && (content == null || content.length > 0);
        }

        function toPC() {
            $("#meta-device-width")
                .attr("content",
                    "")
            window.localStorage.setItem("meta-device-width-content", "")
            $('body').css("min-width", "1600px")
            $(".fixed-mobile")
                .removeClass("hide")
        }

        function toMobile() {
            $("#meta-device-width")
                .attr("content",
                    "width=device-width, initial-scale=1, shrink-to-fit=no")

            $(".fixed-mobile")
                .addClass("hide")

            window.localStorage.setItem("meta-device-width-content",
                "width=device-width, initial-scale=1, shrink-to-fit=no")
        }
    </script>
